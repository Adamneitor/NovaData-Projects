# ============================================
# Nova Projects - Variables de entorno
# Copiar este archivo como .env y completar valores.
# En Railway se configuran desde "Variables".
# ============================================

# Clave secreta de Flask — obligatorio cambiar en producción
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Puerto (Railway lo inyecta automáticamente, local por defecto 5012)
PORT=5012

# Debug: 1 para activar, 0 en producción
FLASK_DEBUG=0

# Base de datos portal NOVA
# Local (omitir): SQLite en instance/nova_projects.db
# Railway: plugin PostgreSQL inyecta DATABASE_URL
# DATABASE_URL=postgresql://user:pass@host:5432/railway

# Helios BPM (embebido)
# Por defecto: SQLite instance/helios.db (sin VPN)
# Railway: reutiliza DATABASE_URL (Postgres)
# Forzar SQL Server banco: HELIOS_USE_MSSQL=1
# HELIOS_USE_MSSQL=0
# HELIOS_DATABASE_URL=
# HELIOS_SQL_SERVER=BVNBEET0110\BIDEV
# HELIOS_SQL_DATABASE=Helios
# Tras importar Helios.bak o CSV export → SQLite/Postgres, desactivar seed demo:
HELIOS_SEED_DEMO=0
# Import CSV empaquetado (blueprints/Helios/data/export) al arrancar si BPM vacío:
# HELIOS_IMPORT_CSV=1   (forzar intento) · HELIOS_IMPORT_CSV=0 (desactivar)
# Import manual:
#   python scripts/import_helios_csv.py --wipe --dir "blueprints\Helios\data\export"

# Fix railpack/mise (también en mise.toml)
# MISE_PYTHON_GITHUB_ATTESTATIONS=false
